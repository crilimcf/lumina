# ── obrigatórias ──
DATABASE_URL=postgresql://user:pass@host:5432/lumina
JWT_SECRET=gera-com-openssl-rand-base64-48
PGSSL=true

# ── endereços ──
PORT=3000
APP_URL=https://lumina-snowy-ten.vercel.app
CORS_ORIGIN=https://lumina-snowy-ten.vercel.app

# ── email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM=Lumina <ola@teudominio.pt>

# ── media (Cloudflare R2) ──
S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
S3_BUCKET=lumina
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://imagens.teudominio.pt

# ── Diretos (Amazon IVS Real-Time) ──
# Credenciais exclusivas do backend; nunca usar credenciais root nem expor ao frontend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_IVS_STORAGE_CONFIGURATION_ARN=
AWS_IVS_RECORDINGS_BUCKET=

# Push nativo Android (Firebase Cloud Messaging HTTP v1)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Push nativo iOS (Apple Push Notification service)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=pt.digibox.lumina
APNS_PRODUCTION=true

# ── Salas Ultra / Stripe ──
# Sem estas chaves, salas públicas/privadas funcionam mas Ultra não finge pagamentos.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ULTRA_ROOM_CREATE_CENTS=299
ULTRA_ROOM_ENTRY_CENTS=149

# ── desligado até haver escala ──
FEATURE_SUBSCRIPTIONS=false

# ── moderação ──
REPORTS_TO_AUTOHIDE=3
PROPOSALS_PER_WEEK=3
MIN_ACCOUNT_AGE_HOURS=24

# ── convites legado e mensagens ──
SEED_PROPOSALS_REQUIRED=5
EPHEMERAL_SECONDS=10
ONCE_SECONDS=6
