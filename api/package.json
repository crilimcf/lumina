{
  "name": "lumina-api",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node -e \"import('./src/db.js').then(m=>m.migrate().then(()=>{console.log('migrado');process.exit(0)}))\"",
    "seed": "node scripts/seed.js",
    "cron": "node scripts/cron.js",
    "cron:invites": "node scripts/cron.js invites",
    "cron:purge": "node scripts/cron.js purge",
    "cron:deletions": "node scripts/cron.js deletions"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0"
  }
}
