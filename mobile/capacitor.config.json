{
  "appId": "com.crilimcf.lumina",
  "appName": "Lumina",
  "webDir": "../web/dist",
  "bundledWebRuntime": false,
  "server": {
    "iosScheme": "capacitor",
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#07101EFF",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#07101E",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "banner", "list"]
    }
  }
}
