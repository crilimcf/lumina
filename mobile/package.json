{
  "name": "lumina-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "build:web": "npm run prepare:web && npm --prefix ../web run build",
    "native:add:android": "npx cap add android",
    "native:add:ios": "npx cap add ios",
    "native:sync": "npx cap sync",
    "configure:android": "node scripts/configure-native.mjs android",
    "configure:ios": "node scripts/configure-native.mjs ios",
    "readiness": "node scripts/store-readiness.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "sharp": "^0.34.3"
  }
}
