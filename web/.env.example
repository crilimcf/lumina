# API normalmente é /api através do proxy Vercel.
# VITE_API_URL=

# Apenas para builds iOS instalados diretamente com perfil Development.
# TestFlight e App Store usam production.
# VITE_APNS_ENVIRONMENT=sandbox

# TURN opcional para chamadas WebRTC fiáveis em redes onde P2P/STUN não chega.
# Ex.: turn:turn.teudominio.pt:3478?transport=udp,turns:turn.teudominio.pt:5349?transport=tcp
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
